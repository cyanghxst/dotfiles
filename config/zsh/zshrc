# ------------------------------------------------------------
# Zshrc: interactive shells. Aliases, prompt, completion, etc.
# PATH and environment live in zprofile.
# ------------------------------------------------------------

# only run the rest for interactive shells
[[ $- != *i* ]] && return

# non-login shells (e.g. tmux panes) skip zprofile, so source it once
if [[ -z ${PROFILE_SOURCED:-} && -r ~/.zprofile ]]; then
    source ~/.zprofile
fi

# --------
# Options
# --------

setopt auto_cd

HISTSIZE=5000
HISTFILE=~/.zsh_history
SAVEHIST=$HISTSIZE
HISTDUP=erase

setopt appendhistory
setopt sharehistory
setopt hist_ignore_space
setopt hist_ignore_all_dups
setopt hist_save_no_dups
setopt hist_ignore_dups
setopt hist_find_no_dups

# ----------
# SSH keys
# ----------

keys=("$HOME"/.ssh/id_ed*(-N))

if (( ${#keys} )); then
    for key in "${keys[@]}"; do
        [[ -f $key && $key != *.pub ]] || continue
        if ssh-add -l 2>/dev/null | grep -q " $(ssh-keygen -lf "$key" | awk '{print $2}') "; then
            continue
        fi
        ssh-add --apple-use-keychain "$key" >/dev/null 2>&1
    done
fi

# ------------
# Keybindings
# ------------

bindkey -e # Emacs bindings
bindkey '^p' history-search-backward
bindkey '^n' history-search-forward

# --------------
# Prompt hooks
# --------------

# newline between commands
precmd() {
    if [[ -z "$NEW_LINE_BEFORE_PROMPT" ]]; then
        NEW_LINE_BEFORE_PROMPT=1
    elif [[ "$NEW_LINE_BEFORE_PROMPT" -eq 1 ]]; then
        echo ""
    fi
}

# Emit OSC 133;A (prompt start) so terminals can jump between prompts
_osc133_prompt_start() { print -n '\e]133;A\e\\' }
precmd_functions+=(_osc133_prompt_start)

# wipe the "Last login" banner
clear

# --------
# Aliases
# --------

# better ls (gnu)
LS_COMMON="--color=auto --literal"
alias ls="command ls $LS_COMMON -lh"
alias lst="command ls $LS_COMMON -lth"
alias lsd="command ls $LS_COMMON -ldh .*"
alias lsdt="command ls $LS_COMMON -ldth .*"

# FZF helpers
alias of='fzf --print0 | xargs -0 -o open'
alias cf='cd "$(find . -type d -not -path "*/.git*" -not -path "./.*" | sed "s|^\./||" | sort | fzf || pwd)"'
alias cf1='cd "$(find . -maxdepth 1 -type d -not -path "*/.git*" -not -path "./.*" | sed "s|^\./||" | sort | fzf || pwd)"'

# misc
alias grep='grep --color=auto'
alias clear='unset NEW_LINE_BEFORE_PROMPT && clear'
alias dirs='dirs -v'
alias fastfetch='fastfetch | lolcat -F 0.097 -S 30 -a -d 1 -s 35'
# alias fastfetch='fastfetch | lolcat -F 0.05 -S 22 -a -d 1 -s 20'
alias forsay='\fortune > a.txt | cowsay && say -f a.txt && rm a.txt'
alias fortune='fortune | cowsay'
alias gg='git-graph --style round'
alias zsh='source ~/.zshrc'

# -------------------
# Colors and viewers
# -------------------

export FZF_DEFAULT_OPTS='
--height=40% --layout=reverse --info=inline --border --margin=1 --padding=1
--color=fg:#c0caf5,fg+:#16161e
--pointer=">"
--color=bg:-1,bg+:#9ece6a
--color=hl:#fa2d90,hl+:#16161e
--color=gutter:#414868
--color=scrollbar:#414868
--color=info:#9ece6a,pointer:#16161e
--color=border:#414868,spinner:#7aa2f7,header:#7E8E91,marker:#F92672,prompt:#9ece6a'

export LS_COLORS="di=34:ln=35:so=32:pi=33:ex=31:bd=46;30:cd=43;30:su=37;41:sg=30;43:tw=30;42:ow=34;42:"

# man page colors
export LESS_TERMCAP_mb=$(tput bold; tput setaf 2) # green
export LESS_TERMCAP_md=$(tput bold; tput setaf 2) # green
export LESS_TERMCAP_so=$(tput bold; tput rev; tput setaf 3) # yellow
export LESS_TERMCAP_se=$(tput rmso; tput sgr0)
export LESS_TERMCAP_us=$(tput smul; tput setaf 4) # blue
export LESS_TERMCAP_me=$(tput sgr0)

# -----------
# Completion
# -----------

zstyle ':completion:*' matcher-list '' 'm:{a-zA-Z}={A-Za-z}' 'r:|=*' 'l:|=* r:|=*'
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
fpath=("$HOMEBREW_PREFIX/share/zsh/site-functions" $fpath)

# versioned cache
mkdir -p ~/.cache/zsh
autoload -Uz compinit
compinit -d ~/.cache/zsh/zcompdump-$ZSH_VERSION

# gh (`command` bypasses the op plugin alias so startup never triggers a 1Password prompt)
if command -v gh >/dev/null 2>&1; then
    eval "$(command gh completion -s zsh)"
fi

# ---------------
# Lazy-loaded env
# ---------------

# mise
mise() {
    unfunction mise
    eval "$(command mise activate zsh)"
    mise "$@"
}

# sdk: zprofile defines it in login shells, but functions aren't inherited,
# so non-login shells load it on first use
if (( ! $+functions[sdk] )) && [[ -s "$SDKMAN_DIR/bin/sdkman-init.sh" ]]; then
    sdk() {
        unfunction sdk
        source "$SDKMAN_DIR/bin/sdkman-init.sh"
        sdk "$@"
    }
fi

# ---------------------
# Plugins and sourcing
# ---------------------

if [[ -r "$HOME"/.config/op/plugins.sh ]]; then
    source "$HOME"/.config/op/plugins.sh
fi

if [[ -f "$HOME"/.config/tokens/.env ]]; then
    source "$HOME"/.config/tokens/.env
fi

if [[ -r ~/.zsh/prompt.zsh ]]; then
    source ~/.zsh/prompt.zsh
fi

# custom functions
for func in ~/.zsh/functions/*.zsh(N); do
    source "$func"
done

if [[ -r /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh ]]; then
    source /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh
fi

# must be sourced last
if [[ -r /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]]; then
    source /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
fi
